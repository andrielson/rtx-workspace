# Dummy env for the Tests stack workspace. Copy to tests/.env.service.test
# (gitignored). user-install.sh skips SSH-key setup when SSH_AUTHORIZED_KEY is
# empty and skips GitHub setup when GH_TOKEN is empty — no real secrets here.
GIT_AUTHOR_NAME="Test User"
GIT_COMMITTER_NAME="Test User"
GIT_AUTHOR_EMAIL="test@example.com"
GIT_COMMITTER_EMAIL="test@example.com"

SSH_AUTHORIZED_KEY=
GH_TOKEN=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
