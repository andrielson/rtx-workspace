# syntax=docker/dockerfile:1
# The Tests stack's nginx. A bind mount would serve the Bootstrap script
# from the host filesystem, but the Docker daemon resolves bind sources
# against the host — a path that does not exist when the suite runs from
# inside a workspace, where the repo lives in the /nix volume. Baking the
# script into an image ships it through the build context instead, which
# always travels client-side. The context is src/ (reached through the
# tests/src symlink; see the Tests compose file and src/.dockerignore), so
# the script sits at the context root. This Dockerfile itself stays in
# tests/, outside the context, and reaches the builder through the
# Dockerfile's own transfer (ADR 0004, ADR 0007).
FROM nginx:alpine

COPY user-install.sh /usr/share/nginx/html/user-install.sh
