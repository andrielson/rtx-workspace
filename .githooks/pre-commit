#!/bin/sh
# Pre-commit hook: lint staged source files with Biome, lint and format-check
# staged shell files with ShellCheck/shfmt, validate staged Compose YAML,
# then type check the whole repo.
# Git runs this because `bun install` sets `core.hooksPath` to `.githooks` (see package.json).
# To skip it in an emergency: `git commit --no-verify`.

staged_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.jsonc')

if [ -n "${staged_files}" ]; then
  # Intentional word splitting: file names with whitespace are not supported here.
  # shellcheck disable=SC2086
  if ! bunx biome check --no-errors-on-unmatched ${staged_files}; then
    echo "pre-commit: Biome found issues. Run 'bun run lint:fix', then stage the fixes." >&2
    exit 1
  fi
fi

staged_shell_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.sh' '*.bash' '.githooks/pre-commit')

if [ -n "${staged_shell_files}" ]; then
  # Intentional word splitting: file names with whitespace are not supported here.
  # shellcheck disable=SC2086
  if ! shellcheck --shell=bash ${staged_shell_files}; then
    echo "pre-commit: ShellCheck found issues. Run 'bun run lint:sh' for the full report." >&2
    exit 1
  fi

  # Intentional word splitting: file names with whitespace are not supported here.
  # shellcheck disable=SC2086
  if ! shfmt --diff ${staged_shell_files}; then
    echo "pre-commit: shfmt found formatting diffs. Run 'bun run format:sh'." >&2
    exit 1
  fi
fi

staged_yaml_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.yml' '*.yaml')

if [ -n "${staged_yaml_files}" ]; then
  if ! bun run lint:compose; then
    echo "pre-commit: Compose validation failed. Run 'bun run lint:compose' for details." >&2
    exit 1
  fi
fi

if ! bun run typecheck; then
  echo "pre-commit: type checking failed. Run 'bun run typecheck' for details." >&2
  exit 1
fi
